    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/filesystem": "8.1.5",
    "chess.js": "0.10.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "vite": "6.3.5",
    "vite-plugin-singlefile": "2.2.0"
  }
